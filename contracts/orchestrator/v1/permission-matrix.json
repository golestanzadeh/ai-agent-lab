{
  "schema_version": 1,
  "matrix_id": "PERMISSION_MATRIX_V1",
  "default_outcome": "DENY",
  "tiers": {
    "A0": {"rank": 0, "scope": "canonical governance and architecture read"},
    "A1": {"rank": 1, "scope": "sanitized repository task read"},
    "A2": {"rank": 2, "scope": "bounded non-main branch write"},
    "A3": {"rank": 3, "scope": "minimum necessary read for one validated case and run"},
    "A4": {"rank": 4, "scope": "derived-artifact write for one validated case and run"},
    "A5": {"rank": 5, "scope": "bounded reversible service control"},
    "A6": {"rank": 6, "scope": "high-risk exact action mediated by Human Gate and deterministic broker"},
    "AX": {"rank": -1, "scope": "denied, expired, revoked, ambiguous, or out of scope"}
  },
  "capabilities": {
    "governance_review": {"maximum_tier": "A1"},
    "security_review": {"maximum_tier": "A1"},
    "privacy_review": {"maximum_tier": "A1"},
    "acceptance_review": {"maximum_tier": "A1"},
    "audit_review": {"maximum_tier": "A1"},
    "checkpoint_review": {"maximum_tier": "A1"},
    "record_control_finding": {"maximum_tier": "A1"},
    "read_test_evidence": {"maximum_tier": "A1"},
    "plan_tasks": {"maximum_tier": "A1"},
    "propose_acceptance_criteria": {"maximum_tier": "A1"},
    "propose_manifest": {"maximum_tier": "A1"},
    "select_validated_role": {"maximum_tier": "A1"},
    "dispatch_registered_task": {"maximum_tier": "A1"},
    "monitor_tasks": {"maximum_tier": "A1"},
    "request_retry": {"maximum_tier": "A1"},
    "request_human_gate": {"maximum_tier": "A1"},
    "update_documentation": {"maximum_tier": "A2"},
    "propose_checkpoint": {"maximum_tier": "A2"},
    "design_contract": {"maximum_tier": "A1"},
    "write_bounded_branch": {"maximum_tier": "A2"},
    "write_tests": {"maximum_tier": "A2"},
    "run_tests": {"maximum_tier": "A2"},
    "report_evidence": {"maximum_tier": "A1"},
    "inspect_operational_metadata": {"maximum_tier": "A1"},
    "reversible_service_control": {"maximum_tier": "A5", "temporary_only": true},
    "resolve_case_scope": {"maximum_tier": "A3", "case_run_required": true},
    "dispatch_case_chain": {"maximum_tier": "A3", "case_run_required": true},
    "read_case_packet": {"maximum_tier": "A3", "case_run_required": true},
    "read_derived_case_artifact": {"maximum_tier": "A3", "case_run_required": true},
    "write_derived_case_artifact": {"maximum_tier": "A4", "case_run_required": true},
    "report_evidence_gap": {"maximum_tier": "A4", "case_run_required": true},
    "research_authoritative_law": {"maximum_tier": "A4", "case_run_required": true},
    "propose_tax_opportunity": {"maximum_tier": "A4", "case_run_required": true},
    "run_deterministic_calculator": {"maximum_tier": "A4", "case_run_required": true},
    "challenge_tax_analysis": {"maximum_tier": "A4", "case_run_required": true},
    "record_tax_analysis_decision": {"maximum_tier": "A4", "case_run_required": true},
    "direct_tax_recheck": {"maximum_tier": "A4", "case_run_required": true},
    "map_official_form": {"maximum_tier": "A4", "case_run_required": true},
    "credential_administration": {"maximum_tier": "A6", "human_gate_required": true, "no_standing_agent_permission": true},
    "protected_main_merge": {"maximum_tier": "A6", "human_gate_required": true, "no_standing_agent_permission": true},
    "production_release": {"maximum_tier": "A6", "human_gate_required": true, "no_standing_agent_permission": true},
    "destructive_action": {"maximum_tier": "A6", "human_gate_required": true, "no_standing_agent_permission": true},
    "content_release_approval": {"maximum_tier": "A6", "human_gate_required": true, "human_only": true, "no_standing_agent_permission": true},
    "destination_transmission_approval": {"maximum_tier": "A6", "human_gate_required": true, "human_only": true, "no_standing_agent_permission": true},
    "external_transfer": {"maximum_tier": "A6", "human_gate_required": true, "deterministic_gateway_only": true, "no_standing_agent_permission": true}
  },
  "role_permissions": [
    {"role_id": "GOVERNANCE_GUARD_AGENT", "default_tiers": ["A0", "A1"]},
    {"role_id": "SECURITY_PRIVACY_AGENT", "default_tiers": ["A0", "A1"]},
    {"role_id": "INDEPENDENT_ACCEPTANCE_AGENT", "default_tiers": ["A0", "A1"]},
    {"role_id": "AUDIT_CONTINUITY_AGENT", "default_tiers": ["A0", "A1"]},
    {"role_id": "MASTER_PROJECT_ORCHESTRATOR", "default_tiers": ["A0", "A1"]},
    {"role_id": "PLANNING_DEPENDENCY_AGENT", "default_tiers": ["A0", "A1"]},
    {"role_id": "AGENT_FACTORY_SUPERVISOR", "default_tiers": ["A0", "A1"]},
    {"role_id": "DOCUMENTATION_STATE_AGENT", "default_tiers": ["A2"]},
    {"role_id": "OPERATIONS_INTEGRATION_AGENT", "default_tiers": ["A0", "A1"], "temporary_tiers": ["A5"]},
    {"role_id": "ARCHITECTURE_AGENT", "default_tiers": ["A0", "A1"]},
    {"role_id": "IMPLEMENTATION_AGENT", "default_tiers": ["A0", "A1"], "temporary_tiers": ["A2"]},
    {"role_id": "QUALITY_ENGINEERING_AGENT", "default_tiers": ["A1", "A2"]},
    {"role_id": "CASE_ORCHESTRATOR_AGENT", "default_tiers": ["A3", "A4"]},
    {"role_id": "CHIEF_TAX_AUDITOR_AGENT", "default_tiers": ["A3"], "temporary_tiers": ["A4"]},
    {"role_id": "EVIDENCE_AGENT", "default_tiers": ["A3", "A4"]},
    {"role_id": "TAX_LAW_AGENT", "default_tiers": ["A3", "A4"]},
    {"role_id": "OPPORTUNITY_AGENT", "default_tiers": ["A3", "A4"]},
    {"role_id": "CALCULATION_AGENT", "default_tiers": ["A3", "A4"]},
    {"role_id": "ADVERSARIAL_REVIEWER_AGENT", "default_tiers": ["A3", "A4"]},
    {"role_id": "ELSTER_FORM_AGENT", "default_tiers": ["A3", "A4"]}
  ],
  "rules": [
    "permission not explicitly granted is denied",
    "all temporary tiers require a validated manifest and expiry",
    "A3 and A4 require exact case_id, tax_year, and run_id",
    "A6 is never standing Agent permission",
    "ambiguous, expired, revoked, or mismatched scope resolves to AX"
  ]
}
