{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-lab.local/contracts/orchestrator/v1/response.schema.json",
  "title": "Agent Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "response_id", "task_id", "parent_task_id", "role_id",
    "actor_instance_id", "status", "result_summary", "artifact_references",
    "changed_paths_or_state", "tests", "evidence", "authority_used",
    "costs", "unresolved_risks", "recommended_next_action", "human_required",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "response_id": {"type": "string", "pattern": "^RESP-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "task_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": ["string", "null"]},
    "role_id": {"type": "string", "minLength": 1},
    "actor_instance_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "BLOCKED", "HUMAN_REQUIRED", "FAILED", "EXPIRED", "CANCELLED"]},
    "result_summary": {"type": "string", "minLength": 1},
    "artifact_references": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "changed_paths_or_state": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "tests": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "outcome", "evidence_reference"], "properties": {"name": {"type": "string", "minLength": 1}, "outcome": {"enum": ["PASS", "FAIL", "SKIPPED", "NOT_RUN"]}, "evidence_reference": {"type": ["string", "null"]}}}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "authority_used": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "costs": {"type": "object", "additionalProperties": false, "required": ["tokens_used", "tool_calls_used", "cost_usd"], "properties": {"tokens_used": {"type": "integer", "minimum": 0}, "tool_calls_used": {"type": "integer", "minimum": 0}, "cost_usd": {"type": "number", "minimum": 0}}},
    "unresolved_risks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "human_required": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "HUMAN_REQUIRED"}}}, "then": {"properties": {"human_required": {"const": true}}}}
  ]
}
