{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-lab.local/contracts/orchestrator/v1/task.schema.json",
  "title": "Registered Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "parent_task_id", "objective", "role_id",
    "actor_instance_id", "repository", "ref", "case_context", "inputs",
    "expected_outputs", "allowed_tools", "permissions", "forbidden_actions",
    "budget", "timeout_seconds", "max_retries", "acceptance_criteria",
    "stop_conditions", "escalation_route", "created_at", "expires_at", "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "parent_task_id": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "role_id": {"type": "string", "minLength": 1},
    "actor_instance_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "case_context": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "tax_year", "run_id"],
          "properties": {
            "case_id": {"type": "string", "minLength": 1},
            "tax_year": {"type": "integer"},
            "run_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "expected_outputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "allowed_tools": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "forbidden_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "budget": {"type": "object", "additionalProperties": false, "required": ["token_limit", "tool_call_limit", "cost_limit_usd"], "properties": {"token_limit": {"type": "integer", "minimum": 1}, "tool_call_limit": {"type": "integer", "minimum": 1}, "cost_limit_usd": {"type": "number", "exclusiveMinimum": 0}}},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "max_retries": {"type": "integer", "minimum": 0},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "escalation_route": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"const": "REGISTERED"}
  }
}
